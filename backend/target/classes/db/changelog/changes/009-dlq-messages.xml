<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="009-create-dlq-messages" author="team">
        <createTable tableName="dlq_messages">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="event_id" type="VARCHAR(36)"><constraints nullable="false" unique="true"/></column>
            <column name="trade_ref" type="VARCHAR(30)"><constraints nullable="false"/></column>
            <column name="original_topic" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="topic_partition" type="INT"><constraints nullable="false"/></column>
            <column name="record_offset" type="BIGINT"><constraints nullable="false"/></column>
            <column name="payload_json" type="VARCHAR(1000000)"><constraints nullable="false"/></column>
            <column name="reason" type="VARCHAR(1000000)"/>
            <column name="first_seen" type="TIMESTAMP"><constraints nullable="false"/></column>
        </createTable>
        <rollback>
            <dropTable tableName="dlq_messages"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
